# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ticketdist
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ticketdist
# URL completa usada por el backend (asyncpg). En local sin compose usa localhost:
DATABASE_URL=postgresql+asyncpg://ticketdist:change-me-postgres@postgres:5432/ticketdist

# ─── Backend ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Orígenes permitidos para CORS (coma-separados, o "*" para permitir todos).
# El UI usa token Bearer (sin cookies), por lo que "*" es seguro aquí.
CORS_ORIGINS=*

# ─── JWT ──────────────────────────────────────────────────────
# Genera un valor fuerte antes de desplegar: openssl rand -hex 32
JWT_SECRET_KEY=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── Usuario admin sembrado al iniciar ────────────────────────
ADMIN_EMAIL=admin@empresa.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# ─── SMTP (opcional — envío de correo server-side, no requerido en v1) ─
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Cloudflare Tunnel (opcional — para exponer en producción futura) ─
CLOUDFLARE_TUNNEL_TOKEN=
